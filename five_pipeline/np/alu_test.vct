    A[31:0] = # 10 32'hFFFF_FFFF;	//  All 1s 
    A[31:0] = # 10 32'h1234_5678;	//  Same values = 0 XOR 
    A[31:0] = # 10 32'hFFFF_FFFF;	//  All 1s 
    A[31:0] = # 10 32'hAAAA_AAAA;	//  Bit inversion 
    A[31:0] = # 10 32'hFFFF_FFFF;	//  -1 < 1  => 1 (True) ILT 
    A[31:0] = # 10 32'h0000_0001;	//  1 < -1  => 0 (False) 
    A[31:0] = # 10 32'h8000_0000;	//  Min < Max => 1 (True) 
    A[31:0] = # 10 32'h0000_0005;	//  5 < 5    => 0 (Equal) 
    A[31:0] = # 10 32'h0000_0001;	//  1 < Large => 1 (True) ILTU 
    A[31:0] = # 10 32'hFFFF_FFFF;	//  Large < 1 => 0 (False) 
    A[31:0] = # 10 32'hFFFF_FFFF;	//  same =>0(False) 
    A[31:0] = # 10 32'h0000_0000;	//  0 < Max   => 1 (True) 
    A[31:0] = # 10 32'h0000_0001;	//  1 >= -1 => 1 (True) IGE 
    A[31:0] = # 10 32'hFFFF_FFFF;	//  -1 >= 1 => 0 (False) 
    A[31:0] = # 10 32'h7FFF_FFFF;	//  Max >= Max => 1 (Equal) 
    A[31:0] = # 10 32'hFFFF_FFFF;	//  Max >= 0 => 1 (True) IGEU 
    A[31:0] = # 10 32'h0000_0000;	//  0 >= Max => 0 (False) 
    A[31:0] = # 10 32'h8000_0000;	//  Same => 1 
    A[31:0] = # 10 32'hABCD_1234;	//  Same => 1 
    A[31:0] = # 10 32'h0000_0000;	//  Zero => 1 
    A[31:0] = # 10 32'h0000_0001;	//  Diff => 0 
    A[31:0] = # 10 32'h0000_0001;	//  Diff => 1 
    A[31:0] = # 10 32'hFFFF_FFFF;	//  Same => 0 
    A[31:0] = # 10 32'h0000_0000;	//  Zero/Max => 1 
    A[31:0] = # 10 32'h0000_0000;	//  Zero/Max => 1 
end

