    A[31:0] = # 10 32'h0000_0000;	//  0-1 (Underflow) 
    A[31:0] = # 10 32'h8000_0000;	//  Min-1 (Overflow) 
    A[31:0] = # 10 32'hFFFF_FFFF;	//  All & Zero = 0 AND 
    A[31:0] = # 10 32'hAAAA_AAAA;	//  Alternating = 0 
    A[31:0] = # 10 32'hF0F0_F0F0;	//  F0F0... 
    A[31:0] = # 10 32'hAAAA_AAAA;	//  Result: FFFFFFFF OR 
